<Window x:Class="Clawmeter.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:tb="http://www.hardcodet.net/taskbar"
        Title="Clawmeter"
        Height="380" Width="520"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        Background="{DynamicResource MahApps.Brushes.Window.Background}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Vertical" Margin="0,0,0,12">
            <TextBlock Text="Clawmeter" FontSize="22" FontWeight="Bold" />
            <TextBlock x:Name="StatusText"
                       Text="Connecting..."
                       FontSize="13"
                       Opacity="0.7" />
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Vertical" Margin="0,8,0,0">

            <!-- Tray icon + context menu -->
            <tb:TaskbarIcon x:Name="TrayIcon"
                            IconSource="app.ico"
                            ToolTipText="Clawmeter">
                <tb:TaskbarIcon.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Open"        Click="OnOpenClicked" />
                        <MenuItem Header="Brightness" >
                            <MenuItem Header="  25%" Click="OnBrightness25" />
                            <MenuItem Header="  50%" Click="OnBrightness50" />
                            <MenuItem Header="  75%" Click="OnBrightness75" />
                            <MenuItem Header="100%" Click="OnBrightness100" />
                        </MenuItem>
                        <Separator />
                        <MenuItem Header="Provider" >
                            <MenuItem Header="MiniMax"     Click="OnProviderMinimax" />
                            <MenuItem Header="Claude"     Click="OnProviderClaude" />
                            <MenuItem Header="Codex"      Click="OnProviderCodex" />
                            <MenuItem Header="OpenRouter" Click="OnProviderOpenRouter" />
                        </MenuItem>
                        <Separator />
                        <MenuItem Header="Quit" Click="OnQuitClicked" />
                    </ContextMenu>
                </tb:TaskbarIcon.ContextMenu>
            </tb:TaskbarIcon>

            <!-- Main content: status + actions -->
            <Border Padding="12" CornerRadius="6"
                    Background="{DynamicResource MahApps.Brushes.Control.Background}">
                <StackPanel>
                    <TextBlock Text="Status" FontWeight="Bold" Margin="0,0,0,6" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Service"     Opacity="0.7" />
                        <TextBlock Grid.Row="0" Grid.Column="1" x:Name="ServiceStatus" Text="—" />
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Provider"    Opacity="0.7" />
                        <TextBlock Grid.Row="1" Grid.Column="1" x:Name="ProviderText" Text="—" />
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Brightness"  Opacity="0.7" />
                        <TextBlock Grid.Row="2" Grid.Column="1" x:Name="BrightnessText" Text="—" />
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="Refresh now"
                                Click="OnPollNowClicked"
                                Margin="0,0,8,0" />
                        <Button Content="Open log folder"
                                Click="OnOpenLogClicked" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</Window>
